# Copiá este archivo a ".env" y completá los valores.

NODE_ENV=development
PORT=3000

# --- Backend ---
VITE_APP_ID=sides_local
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta

# Pegá acá el "Connection string" que te da Neon (neon.tech) al crear tu proyecto.
# Ejemplo: postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# (Si usás Postgres local en vez de Neon: postgresql://postgres:postgres@localhost:5432/sides_adultos_mayores)
DATABASE_URL="postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

OWNER_OPEN_ID=admin

# --- Frontend ---
VITE_APP_TITLE="Sistema de Gestión de Adultos Mayores"
